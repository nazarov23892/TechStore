@page "/"
@using TechStore.Client.HttpServices
@using TechStore.Contracts.DTOs
@inject ICategoriesHttpService CategoriesHttpService;

<div class="container my-3">
    <h3 class="mb-4 fw-bold">Каталог товаров</h3>

    @if (categories == null)
    {
        <p>Загрузка категорий...</p>
    }
    else if (categories?.Items.Any() != true)
    {
        <div class="alert alert-info small">Категории товаров пока не созданы.</div>
    }
    else
    {
        <ul>
            @foreach (var cat in categories.Items)
            {
                <li>
                    <NavLink href="@($"catalog/{@cat.Name}")">@cat.Name</NavLink>
                </li>
            }
        </ul>
    }
</div>

@code {
    PagedListResponseDto<CategoryListDto>? categories;

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
    }

    async Task LoadCategories()
    {
        try
        {
            var response = await CategoriesHttpService.GetPagedListAsync(
              page: 1, perPage: 1000);
            categories = response;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки: {ex.Message}");
        }
    }
}
