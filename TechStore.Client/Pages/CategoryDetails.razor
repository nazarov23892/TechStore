@page "/management/categories/{CategoryId:long}"

@using TechStore.Client.HttpServices
@using TechStore.Contracts.DTOs

@inject ICategoriesHttpService CategoriesHttpService;
@inject NavigationManager Navigation

<div class="container my-3">
    <div class="mb-3">
        <NavLink class="text-decoration-none small text-secondary" href="management/categories">&larr; Назад к категориям</NavLink>
    </div>

    @if (categoryPutModel == null)
    {
        <p class="text-muted small">Загрузка данных категории...</p>
    }
    else
    {
        <h4 class="fw-bold mb-3">Категория</h4>

        <div class="row g-3">

            <div class="col-12 col-md-4">
                <div class="p-3 border rounded bg-light">
                    <h5 class="fs-6 fw-bold mb-2">Обозначение</h5>
                    <input type="text" class="form-control form-control-sm mb-2" @bind="categoryPutModel.Key" />
                    <h5 class="fs-6 fw-bold mb-2">Название</h5>
                    <input type="text" class="form-control form-control-sm mb-2" @bind="categoryPutModel.DisplayName" />
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-primary flex-grow-1" @onclick="UpdateCategory">Сохранить</button>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-8">
                <div class="p-3 border rounded bg-white">
                    <h5 class="fs-6 fw-bold mb-2">Атрибуты (спецификация)</h5>

                    <div class="d-flex flex-column gap-2 mb-3">

                        @foreach (var attr in categoryAttributes)
                        {
                            <div class="p-2 border rounded bg-light d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="fw-medium small">@attr.Key</span>
                                    <span class="text-muted small ms-2">@attr.DataType</span>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="p-2 border-top pt-3">
                        <strong class="small text-secondary d-block mb-2">+ Добавить атрибут:</strong>

                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            <input type="text" class="form-control form-control-sm" style="max-width: 200px;"
                                   placeholder="Например: Сокет" @bind="attributePostModel.Key" />

                            <select class="form-select form-select-sm" style="max-width: 150px;" @bind="attributePostModel.DataType">
                                <option value="Numeric">Число</option>
                                <option value="String">Текст</option>
                                <option value="Boolean">Да/Нет</option>
                            </select>

                            <button class="btn btn-sm btn-success" @onclick="AddAttribute">Добавить</button>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    }
</div>

@code {
    [Parameter]
    public long CategoryId { get; set; }

    CategoryPutDto? categoryPutModel;
    CategoryAttributePostDto attributePostModel = new();
    List<CategoryAttributeListDto> categoryAttributes = [];

    protected override async Task OnInitializedAsync()
    {
        var loadCategoriesTask = LoadCategory(CategoryId);
        var loadAttributesTask = LoadAttributes(CategoryId);
        await Task.WhenAll(loadCategoriesTask, loadAttributesTask);
    }

    async Task LoadCategory(long id)
    {
        try
        {
            var response = await CategoriesHttpService.GetByIdAsync(CategoryId);
            categoryPutModel = new CategoryPutDto()
            {
                Key = response!.Key,
                DisplayName = response.DisplayName,
            };
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки: {ex.Message}");
        }
    }

    async Task LoadAttributes(long id)
    {
        try
        {
            var response = await CategoriesHttpService.GetAttributeListAsync(CategoryId);
            categoryAttributes = response?.ToList() ?? [];
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки: {ex.Message}");
        }
    }

    async Task UpdateCategory()
    {
        if (categoryPutModel == null)
            return;

        try
        {
            var response = await CategoriesHttpService.Update(CategoryId, categoryPutModel);
            if (response == null)
                return;

            categoryPutModel.Key = response.Key;
            categoryPutModel.DisplayName = response.DisplayName;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки: {ex.Message}");
        }
    }

    async Task AddAttribute()
    {
        try
        {
            var response = await CategoriesHttpService.CreateAttributeAsync(
                CategoryId, attributePostModel);
            if (response == null)
                return;

            categoryAttributes.Add(
                new CategoryAttributeListDto()
                {
                    Id = response.Id,
                    Key = response.Key,
                    DataType = response.DataType,
                });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки: {ex.Message}");
        }
        attributePostModel = new();
    }
}
