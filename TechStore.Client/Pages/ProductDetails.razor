@page "/management/products/{ProductId:long}"
@using TechStore.Client.HttpServices
@using TechStore.Contracts.DTOs

@inject IProductHttpService ProductsHttpService
@inject NavigationManager Navigation

<div class="container my-3">
    <div class="mb-3">
        <NavLink class="text-decoration-none small text-secondary" href="management">&larr; Назад в управление</NavLink>
    </div>

    @if (product == null)
    {
        <p class="text-muted small">Загрузка данных товара...</p>
    }
    else
    {
        <h4 class="fw-bold mb-3">Редактирование: @product.Name</h4>

        <div class="row g-3">

            <div class="col-12 col-md-5">
                <div class="p-3 border rounded bg-light">
                    <h5 class="fs-6 fw-bold mb-3">Основная информация</h5>

                    <div class="mb-2">
                        <label class="form-label small mb-1">Название устройства</label>
                        <input type="text" class="form-control form-control-sm" @bind="product.Name" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label small mb-1">Категория</label>
                        <input type="text" class="form-control form-control-sm" value="@product.Category?.Name" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label small mb-1">Цена (₽)</label>
                        <input type="number" class="form-control form-control-sm" @bind="product.Price" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small mb-1">Описание</label>
                        <textarea class="form-control form-control-sm" rows="4" @bind="product.Description"></textarea>
                    </div>

                    <div class="d-flex gap-2 border-top pt-3">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="Cancel">Отмена</button>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-7">
                <div class="p-3 border rounded bg-white">
                    <h5 class="fs-6 fw-bold mb-2">Технические характеристики</h5>
                    <p class="text-muted small mb-3">Свойства генерируются автоматически на основе шаблона категории.</p>

                    <div class="d-flex flex-column gap-3">
                        @foreach (var attr in productAttributes)
                        {
                            var type = attr.DataType == "Numeric" ? "number" : "text";
                            var placeHolder = attr.DataType == "Numeric" ? "Например: 6" : "Например: LGA";
                            <div>
                                <label class="form-label small fw-medium mb-1">@attr.Key</label>
                                <input type="@type" class="form-control form-control-sm" style="max-width: 250px;" placeholder="@placeHolder" />
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {

    [Parameter]
    public long ProductId { get; set; }

    ProductDto? product;
    List<ProductAttributeListDto> productAttributes = [];

    protected override async Task OnInitializedAsync()
    {
        var loadProductTask = LoadProduct();
        var loadAttributesTask = LoadAttributes();
        await Task.WhenAll(loadProductTask, loadAttributesTask);
    }

    async Task LoadProduct()
    {
        try
        {
            var response = await ProductsHttpService.GetByIdAsync(ProductId);
            product = response;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки: {ex.Message}");
        }
    }

    async Task LoadAttributes()
    {
        try
        {
            var response = await ProductsHttpService.GetAttributeListAsync(ProductId);
            productAttributes = response?.ToList() ?? [];
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки: {ex.Message}");
        }
    }

    void Cancel()
    {
        Navigation.NavigateTo("/management");
    }
}
