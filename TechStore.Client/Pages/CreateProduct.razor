@page "/management/create"
@using TechStore.Client.HttpServices
@using TechStore.Contracts.DTOs
@inject IProductHttpService ProductsHttpService
@inject ICategoriesHttpService CategoriesHttpService;
@inject NavigationManager Navigation

<div class="container my-3">
    <h3 class="mb-3">Создание товара</h3>

    <div class="p-3 border rounded bg-light">
        <div class="mb-2">
            <label class="form-label mb-1">Название устройства</label>
            <input type="text" class="form-control form-control-sm" @bind="newProduct.Name" placeholder="Например: Процессор AMD Ryzen 5" />
        </div>

        <div class="mb-2">
            <label class="form-label mb-1">Категория</label>
            <select class="form-select form-select-sm"
                    @bind="newProduct.CategoryId">
                @foreach (var item in categories?.Items ?? Enumerable.Empty<CategoryListDto>())
                {
                    <option value="0" disabled selected>Выберите категорию</option>
                    <option value="@item.Id">@item.Name</option>
                }
            </select>
        </div>

        <div class="mb-2">
            <label class="form-label mb-1">Цена (₽)</label>
            <input type="number" class="form-control form-control-sm" @bind="newProduct.Price" />
        </div>

        <div class="mb-3">
            <label class="form-label mb-1">Описание характеристик</label>
            <textarea class="form-control form-control-sm" rows="3" @bind="newProduct.Description"></textarea>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-primary flex-grow-1" @onclick="AddProduct">Сохранить</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="Cancel">Отмена</button>
        </div>
    </div>
</div>

@code {
    ProductPostDto newProduct = new();
    PagedListResponseDto<CategoryListDto>? categories;

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
    }

    async Task LoadCategories()
    {
        try
        {
            var response = await CategoriesHttpService.GetPagedListAsync(
              page: 1, perPage: 1000);
            categories = response;
        }
        catch(Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки: {ex.Message}");
        }
    }

    async Task AddProduct()
    {
        try
        {
            _ = await ProductsHttpService.CreateAsync(newProduct);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки: {ex.Message}");
            return;
        }
        Navigation.NavigateTo("/management");
    }

    void Cancel()
    {
        Navigation.NavigateTo("/management");
    }
}