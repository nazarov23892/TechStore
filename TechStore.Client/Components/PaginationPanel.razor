
<div class="d-flex justify-content-center gap-1 mt-3">
    @{
        int itemPage = 1;
        do
        {
            var i = itemPage;
            <button class="btn btn-sm @(itemPage == Page ? "btn-primary" : "btn-secondary")"
                    @onclick="() => OnButtonClicked(i)">
                @itemPage
            </button>
            itemPage++;
        } while (itemPage < TotalPages);
    }
</div>

@code {

    /// <summary>
    /// Общее количество страниц.
    /// </summary>
    [EditorRequired]
    [Parameter]
    public int TotalPages { get; set; } = 1;

    /// <summary>
    /// Текущая страница.
    /// </summary>
    [EditorRequired]
    [Parameter]
    public int Page { get; set; } = 1;

    [Parameter]
    public EventCallback<int> PageSelected { get; set; }

    Task OnButtonClicked(int page)
    {
        Console.WriteLine($">> OnButtonClicked {page}");
        if (PageSelected.HasDelegate)
            return PageSelected.InvokeAsync(page);
        return Task.CompletedTask; 
    }
}
